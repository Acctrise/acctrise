# Database
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/acctrise?retryWrites=true&w=majority"

# Redis
REDIS_URL="redis://localhost:6379"

# Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-random-secret"
EXCHANGE_RATE_API_URL="https://open.er-api.com/v6/latest/USD"
JWT_SECRET="replace-with-random-secret"

# Email Service (Sendliberty)
SENDLIBERTY_API_KEY=""
SENDLIBERTY_FROM='"Acctrise" <officialacctrise@gmail.com>'

# TikTok Pixel + server-side Events API
# Generate the access token in TikTok Events Manager. Remove the test event
# code after validation so future events are counted as production events.
TIKTOK_PIXEL_ID="DB9JVKJC77UAEK31ALRG"
TIKTOK_EVENTS_API_ACCESS_TOKEN=""
TIKTOK_TEST_EVENT_CODE="TEST08712"

# PocketFi hosted checkout and webhook funding
POCKETFI_SECRET_KEY=""
POCKETFI_PUBLIC_KEY=""
POCKETFI_BUSINESS_ID=""
POCKETFI_FALLBACK_PHONE=""
POCKETFI_MODE="live"
POCKETFI_BASE_URL="https://api.pocketfi.ng/api/v1"
PAYMENT_FALLBACK_EMAIL="billing@acctrise.com"

# Service providers
# Logs: Bulkacc
# Number generation: GrizzlySMS + SMSBower.
# Boosting: JustAnotherPanel
GRIZZLY_SMS_API_KEY=
SMSBOWER_API_KEY=
BULKACC_API_KEY=""
SUJANDEPARTMENT_API_KEY=""
# Optional: route Sujan API calls through a proxy with a clean IP when the
# provider's bot protection blocks server/datacenter IPs.
# Format: http://user:pass@host:port  (or https://host:port)
SUJANDEPARTMENT_PROXY_URL=""
JUSTANOTHERPANEL_API_KEY=""
CRON_SECRET="replace-with-a-long-random-secret"

# External Providers (NOTE: These should be configured in database with encryption)
# Only shown here for reference - NEVER expose API keys directly
SMM_PROVIDER="justanotherpanel"
SMM_PROVIDER_API_KEY=""
LOGS_PROVIDER="bulkacc"
LOGS_PROVIDER_API_KEY=""
NUMBER_PROVIDER="grizzly-sms,smsbower"
NUMBER_PROVIDER_API_KEY=""

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Configuration
SERVICE_SYNC_INTERVAL_MINUTES="5"
WALLET_WEBHOOK_SECRET="replace-with-webhook-secret"
NODE_ENV="development"
LOG_LEVEL="debug"

# For local development only
DEVELOPMENT_USER_ID="test-user-id"
# Optional: comma-separated DNS resolvers Node should use for mongodb+srv SRV lookups (fixes querySrv ECONNREFUSED on some routers)
MONGODB_DNS_SERVERS=
